rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isActiveAuthenticatedUser() {
      return request.auth != null
        && !exists(/databases/$(database)/documents/accountDeletionRequests/$(request.auth.uid));
    }

    function isOwner(userId) {
      return isActiveAuthenticatedUser()
        && request.auth.uid == userId
        && !exists(/databases/$(database)/documents/accountDeletionRequests/$(userId));
    }

    function hasActiveCheckoutLock(userId) {
      return exists(/databases/$(database)/documents/accountOperationLocks/$(userId))
        && get(/databases/$(database)/documents/accountOperationLocks/$(userId)).data.state == "checkout"
        && get(/databases/$(database)/documents/accountOperationLocks/$(userId)).data.checkoutExpiresAtMillis > request.time.toMillis();
    }

    // Family and friends shared access: an unrevoked grant doc under the owner
    // unlocks read access to that owner's memories for the requesting user.
    function hasApprovedGrant(ownerId, memoryId) {
      return isActiveAuthenticatedUser()
        && !exists(/databases/$(database)/documents/accountDeletionRequests/$(ownerId))
        && exists(/databases/$(database)/documents/users/$(ownerId)/accessGrants/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(ownerId)/accessGrants/$(request.auth.uid)).data.revoked != true
        && (
          get(/databases/$(database)/documents/users/$(ownerId)/accessGrants/$(request.auth.uid)).data.get("memoryId", "") == memoryId
          || (
            get(/databases/$(database)/documents/users/$(ownerId)/accessGrants/$(request.auth.uid)).data.get("memoryId", "") == ""
            && exists(/databases/$(database)/documents/users/$(ownerId)/accessRequests/$(request.auth.uid))
            && get(/databases/$(database)/documents/users/$(ownerId)/accessRequests/$(request.auth.uid)).data.status == "approved"
            && get(/databases/$(database)/documents/users/$(ownerId)/accessRequests/$(request.auth.uid)).data.memoryId == memoryId
          )
        );
    }

    function renderedBookFieldsUnchanged() {
      return request.resource.data.pageWidth == resource.data.pageWidth
        && request.resource.data.pageHeight == resource.data.pageHeight
        && request.resource.data.orientation == resource.data.orientation
        && request.resource.data.layoutVersion == resource.data.layoutVersion
        && request.resource.data.trimSizeInches == resource.data.trimSizeInches
        && request.resource.data.totalPngBytes == resource.data.totalPngBytes
        && request.resource.data.pdfBytes == resource.data.pdfBytes
        && request.resource.data.pdfStoragePath == resource.data.pdfStoragePath
        && request.resource.data.pdfURL == resource.data.pdfURL
        && request.resource.data.pdfPageCount == resource.data.pdfPageCount
        && request.resource.data.renderStatus == resource.data.renderStatus
        && request.resource.data.renderedAt == resource.data.renderedAt;
    }

    function canUpdateBookVersion() {
      return (resource.data.get("hasPaidOrder", false) != true
          || request.resource.data.get("hasPaidOrder", false) == true)
        && (!(resource.data.renderStatus == "rendered") || renderedBookFieldsUnchanged());
    }

    function canFinalizeStorybookJob() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return resource.data.admissionVersion == 1
        && resource.data.status == "aiComplete"
        && request.resource.data.updatedAt == request.time
        && (
          (request.resource.data.status == "complete"
            && changed.hasOnly(["status", "updatedAt"]))
          || (request.resource.data.status == "failed"
            && request.resource.data.error is string
            && request.resource.data.error.size() > 0
            && request.resource.data.error.size() <= 500
            && changed.hasOnly(["status", "error", "updatedAt"]))
        );
    }

    // All user content remains namespaced under users/{uid}/...
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow delete: if false;
      allow create: if isOwner(userId)
        && (!request.resource.data.keys().hasAny(["rcUserId"])
          || (request.resource.data.rcUserId is string
            && request.resource.data.rcUserId.matches('[0-9A-Fa-f-]{36}')));
      allow update: if isOwner(userId)
        && (
          (!resource.data.keys().hasAny(["rcUserId"])
            && (!request.resource.data.keys().hasAny(["rcUserId"])
              || (request.resource.data.rcUserId is string
                && request.resource.data.rcUserId.matches('[0-9A-Fa-f-]{36}'))))
          || (resource.data.keys().hasAny(["rcUserId"])
            && request.resource.data.rcUserId == resource.data.rcUserId)
        );

      match /memories/{memoryId} {
        allow read: if isOwner(userId) || hasApprovedGrant(userId, memoryId);
        allow create, update: if isOwner(userId)
          && !exists(/databases/$(database)/documents/users/$(userId)/memoryTombstones/$(memoryId));
        allow delete: if isOwner(userId);
      }

      // Permanent deletion markers block stale app instances from recreating a
      // deleted memory or uploading its old audio again.
      match /memoryTombstones/{memoryId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && request.resource.data.schemaVersion == 1
          && request.resource.data.keys().hasOnly(["deletedAt", "schemaVersion", "profileId"]);
        allow delete: if false;
      }

      match /memoryAudioTombstones/{audioFile} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && request.resource.data.schemaVersion == 1
          && request.resource.data.keys().hasOnly(["deletedAt", "schemaVersion"]);
        allow delete: if false;
      }

      // Family and friends: requesters create their own request doc (doc id = their
      // uid, so one request per person); only the owner resolves it.
      match /accessRequests/{requesterId} {
        allow read: if isOwner(userId) || (isActiveAuthenticatedUser() && request.auth.uid == requesterId);
        allow create: if isActiveAuthenticatedUser()
          && request.auth.uid == requesterId
          && request.auth.uid != userId
          && request.resource.data.keys().hasOnly([
            "requesterDisplayName", "status", "memoryId", "createdAt"
          ])
          && request.resource.data.status == "pending"
          && request.resource.data.requesterDisplayName is string
          && request.resource.data.requesterDisplayName.size() > 0
          && request.resource.data.requesterDisplayName.size() <= 80
          && request.resource.data.memoryId is string
          && request.resource.data.memoryId.size() == 36
          && request.resource.data.createdAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId)/memories/$(request.resource.data.memoryId));
        allow update: if (isOwner(userId)
          && resource.data.status == "pending"
          && request.resource.data.status in ["approved", "denied"]
          && request.resource.data.respondedAt == request.time
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "status", "respondedAt"
          ]))
          || (isActiveAuthenticatedUser()
            && request.auth.uid == requesterId
            && request.auth.uid != userId
            && resource.data.status in ["denied", "approved"]
            && request.resource.data.keys().hasOnly([
              "requesterDisplayName", "status", "memoryId", "createdAt"
            ])
            && request.resource.data.status == "pending"
            && request.resource.data.requesterDisplayName is string
            && request.resource.data.requesterDisplayName.size() > 0
            && request.resource.data.requesterDisplayName.size() <= 80
            && request.resource.data.memoryId is string
            && request.resource.data.memoryId.size() == 36
            && request.resource.data.createdAt == request.time
            && exists(/databases/$(database)/documents/users/$(userId)/memories/$(request.resource.data.memoryId)));
        allow delete: if false;
      }

      // Grants are owner-written only (approve/revoke); the requester may read their own.
      match /accessGrants/{requesterId} {
        allow read: if isOwner(userId) || (isActiveAuthenticatedUser() && request.auth.uid == requesterId);
        allow create, update: if isOwner(userId)
          && request.resource.data.requesterUid == requesterId
          && request.resource.data.grantedAt == request.time
          && request.resource.data.revoked == false
          && (
            (request.resource.data.keys().hasOnly([
                "requesterUid", "memoryId", "grantedAt", "revoked"
              ])
              && request.resource.data.memoryId is string
              && request.resource.data.memoryId.size() == 36
              && exists(/databases/$(database)/documents/users/$(userId)/memories/$(request.resource.data.memoryId)))
            || (request.resource.data.keys().hasOnly([
                "requesterUid", "grantedAt", "revoked"
              ])
              && existsAfter(/databases/$(database)/documents/users/$(userId)/accessRequests/$(requesterId))
              && getAfter(/databases/$(database)/documents/users/$(userId)/accessRequests/$(requesterId)).data.status == "approved"
              && getAfter(/databases/$(database)/documents/users/$(userId)/accessRequests/$(requesterId)).data.memoryId is string
              && getAfter(/databases/$(database)/documents/users/$(userId)/accessRequests/$(requesterId)).data.memoryId.size() == 36
              && exists(/databases/$(database)/documents/users/$(userId)/memories/$(getAfter(/databases/$(database)/documents/users/$(userId)/accessRequests/$(requesterId)).data.memoryId)))
          );
        allow delete: if false;
      }

      match /books/{bookId} {
        allow read, write: if isOwner(userId);
      }

      match /profiles/{profileId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && !existsAfter(/databases/$(database)/documents/users/$(userId)/profileTombstones/$(profileId));
      }

      match /profileTombstones/{profileId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && request.resource.data.schemaVersion == 1
          && request.resource.data.keys().hasOnly(["deletedAt", "schemaVersion"]);
        allow delete: if false;
      }

      // Per-user dev cost rollups (DevCostTelemetryService) — YYYY-MM-dd doc ids.
      match /apiTelemetry/{dayKey} {
        allow read, write: if isOwner(userId);
      }

      // Per-user manual billing reconciliation entries (DevBillingStore).
      match /devBilling/{dayKey} {
        allow read, write: if isOwner(userId);
      }

      // Server-only AI usage quota counters (aiProxy.js checkAndIncrementQuota).
      // Never client-writable — a client could otherwise reset/inflate its own quota.
      match /aiUsage/{usageId} {
        allow read, write: if false;
      }

      match /bookVersions/{bookVersionId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId);
        allow delete: if isOwner(userId)
          && resource.data.get("hasPaidOrder", false) != true
          && !hasActiveCheckoutLock(userId);
        allow update: if isOwner(userId)
          && !hasActiveCheckoutLock(userId)
          && canUpdateBookVersion();
      }

      // Storybook creation and worker fields are server-only. The client may only
      // finalize an admitted AI-complete job after local book persistence succeeds/fails.
      // Transitional exception: the currently installed App Store binary writes
      // unadmitted jobs directly. Keep only those legacy jobs client-writable until
      // adoption of the callable-based binary is high enough to deploy worker v2.
      match /storybookJobs/{jobId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && request.resource.data.get("admissionVersion", 0) != 1;
        allow update: if isOwner(userId)
          && (canFinalizeStorybookJob() || resource.data.get("admissionVersion", 0) != 1);
        allow delete: if isOwner(userId)
          && resource.data.get("admissionVersion", 0) != 1;
      }

      match /orders/{orderId} {
        allow read: if isOwner(userId);
        allow create, update, delete: if false;
      }

      match /paidBookCheckouts/{paidCheckoutId} {
        allow read: if isOwner(userId);
        allow create, update, delete: if false;
      }
    }

    match /config/pricing {
      allow read: if isActiveAuthenticatedUser();
      allow write: if false;
    }

    // Server-owned markers immediately freeze an account while its deletion
    // job removes Firestore, Storage, Auth, local, and CloudKit-backed data.
    match /accountDeletionRequests/{userId} {
      allow read, write: if false;
    }

    match /accountOperationLocks/{userId} {
      allow read, write: if false;
    }

    // Server-owned Stripe session ledger used to interlock checkout completion
    // with irreversible account deletion.
    match /pendingSingleCheckouts/{sessionId} {
      allow read, write: if false;
    }

    // memoryId → ownerId lookup for scanned QR codes. Server-maintained (Cloud
    // Function trigger + backfill script); contains no memory content.
    match /memoryIndex/{memoryId} {
      allow get: if isActiveAuthenticatedUser();
      allow list: if false;
      allow write: if false;
    }

    // Global developer telemetry aggregates are server-owned. Clients retain
    // per-user diagnostics but cannot poison shared cost totals.
    match /globalApiTelemetry/{dayKey} {
      allow read: if false;
      allow write: if false;
    }

    match /globalApiTelemetryTotals/{docId} {
      allow read: if false;
      allow write: if false;
    }

    // Server-only global AI budget breaker counters.
    match /globalAIUsage/{usageId} {
      allow read, write: if false;
    }
  }
}
